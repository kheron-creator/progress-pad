# Public Supabase config (safe to expose in the browser).
# Copy this file to .env.local and fill in values from the Supabase dashboard:
# Project Settings → API Keys, or the Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used to delete the signed-in Auth user from Clear data.
# Project Settings → API Keys → Secret (or the legacy service_role key).
SUPABASE_SECRET_KEY=
# Optional. Time zone the MCP server (/mcp) uses for "today". Defaults to Europe/London.
PROGRESS_PAD_TIME_ZONE=
